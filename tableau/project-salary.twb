    <worksheet name='Порівняння рівня ЗП Чол vs Жін (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' fontname='Tableau Semibold' fontsize='12'>Порівняння рівня ЗП Чоловіків vs Жінок</run>
