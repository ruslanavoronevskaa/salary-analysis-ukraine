      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1mes8eq1novha717cegds1toloe1].[usr:Calculation_0413454460956672:qk]&quot;' value='Жінки' />
          <alias key='&quot;[federated.1mes8eq1novha717cegds1toloe1].[usr:Calculation_0413454461046785:qk]&quot;' value='Чоловіки' />
          <alias key='&quot;[federated.1mes8eq1novha717cegds1toloe1].[usr:Calculation_0608341537574915:qk]&quot;' value='Гендерний розрив' />
        </aliases>
      </column>
      <column caption='Salary Women' datatype='real' name='[Calculation_0413454460956672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Стать] = &quot;Жінки&quot;&#13;&#10;    THEN [Заробітна плата]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Salary Men' datatype='real' name='[Calculation_0413454461046785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Стать] = &quot;Чоловіки&quot;&#13;&#10;    THEN [Заробітна плата]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Top/Bottom 10' datatype='boolean' name='[Calculation_0608341528530945]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0608341527924736] = &quot;Top 10&quot; THEN&#13;&#10;    RANK(SUM([Заробітна плата]), &apos;desc&apos;) &lt;= 10&#13;&#10;ELSE&#13;&#10;    RANK(SUM([Заробітна плата]), &apos;asc&apos;) &lt;= 10&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Gender Pay Gap %' datatype='real' name='[Calculation_0608341537574915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    AVG(IF [Стать] = &quot;Чоловіки&quot; THEN [Заробітна плата] END)&#13;&#10;    -&#13;&#10;    AVG(IF [Стать] = &quot;Жінки&quot; THEN [Заробітна плата] END)&#13;&#10;)&#13;&#10;/&#13;&#10;AVG(IF [Стать] = &quot;Жінки&quot; THEN [Заробітна плата] END)*100' />
      </column>
      <column caption='salary_research_tableau (1).xls' datatype='table' name='[__tableau_internal_object_id__].[salary_research_tableau (1).xls_12068360A1D44B3FAE01ABF00CA08DAA]' role='measure' type='quantitative' />
